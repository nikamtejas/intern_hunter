# Copy this file to .env and fill in your keys.
# Keys can also be set from the Settings page in the app (saved in the local database).

# Groq — required for resume tailoring and cover letters. Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Adzuna — optional (India + Germany). Free key: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Target ATS score the improve-loop aims for (0-100)
ATS_TARGET=98
ATS_MAX_ROUNDS=4

# LinkedIn politeness (seconds between requests). Keep >= 1.5 to avoid blocks.
LINKEDIN_DELAY=2.0
LINKEDIN_MAX_PAGES=4
